{
  "name": "nexus-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Nexus Commerce + Fleet Telemetry monorepo — unified Supabase backend",
  "workspaces": [
    "apps/store",
    "apps/fleet",
    "packages/domain"
  ],
  "scripts": {
    "dev": "npx concurrently -n store,fleet -c blue,green \"npm run dev:store\" \"npm run dev:fleet\"",
    "dev:store": "npm run dev -w apps/store",
    "dev:fleet": "npm run dev -w apps/fleet",
    "build:store": "npm run build -w apps/store",
    "build:fleet": "npm run build -w apps/fleet",
    "lint": "npm run lint --workspaces --if-present",
    "assets:store": "node scripts/generate-store-image-assets.mjs && node scripts/download-store-font.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:functions",
    "test": "npm run test --workspaces --if-present",
    "mutation": "npm run mutation -w @nexus/domain",
    "typecheck:functions": "tsc -p supabase/functions/order-worker && tsc -p supabase/functions/telemetry-ingest",
    "test:db": "supabase test db"
  },
  "author": "Admaal",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "pdf-lib": "^1.17.1"
  }
}
