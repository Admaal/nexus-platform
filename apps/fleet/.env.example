# Mismo proyecto Supabase que apps/store. En local: npx supabase status -o env
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="tu_anon_key"
VITE_TELEMETRY_INGEST_URL="http://127.0.0.1:54321/functions/v1/telemetry-ingest"
# Clave pública de CARTO, restringida a localhost:5174 y al dominio de Fleet
VITE_CARTO_API_KEY="tu_clave_publica_de_CARTO"
# URL de la tienda (enlace "Volver a la tienda" del seguimiento)
VITE_STORE_URL="http://localhost:5173"
# UUID de demo cuando no hay ?tracking_id=
VITE_TRUCK_ID="demo-truck-1"
