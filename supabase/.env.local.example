# En local no se envía correo: solo se deja constancia en el log.
EMAIL_PROVIDER=log
# Camión permitido en telemetry-ingest sin pedido (el simulador del panel de flota).
DEMO_TRUCK_ID=demo-truck-1
FLEET_TRACKING_URL=http://localhost:5174
