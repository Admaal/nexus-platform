# Secrets de Edge Functions (NO commitear valores reales)
# Configurar con: npx supabase secrets set --project-ref yiarfffsaciuodbplxus KEY=valor

# Email (Brevo)
# BREVO_API_KEY=xkeysib-...
# SENDER_EMAIL=tu_email_verificado_en_brevo

# Auth de Edge Functions (genera valores aleatorios largos)
# PROCESS_ORDER_SECRET=...
# TELEMETRY_INGEST_SECRET=...

# Producción: URL pública de fleet (Vercel)
# FLEET_TRACKING_URL=https://tu-fleet.vercel.app

# Vault (mismo valor que PROCESS_ORDER_SECRET) — para el trigger DB:
# En SQL Editor de Supabase:
# SELECT vault.create_secret('TU_PROCESS_ORDER_SECRET', 'PROCESS_ORDER_SECRET', 'Trigger pg_net');
