# Secrets de Edge Functions (NO commitear valores reales)
# Configurar con: npx supabase secrets set --project-ref <project-ref> KEY=valor

# Email (Brevo). En local usa EMAIL_PROVIDER=log para no enviar nada.
# BREVO_API_KEY=xkeysib-...
# SENDER_EMAIL=tu_email_verificado_en_brevo
# EMAIL_PROVIDER=brevo

# Auth del worker (genera un valor aleatorio largo)
# ORDER_WORKER_SECRET=...
# ORDER_MAX_ATTEMPTS=5

# Telemetría: camión de demo permitido y límite por minuto
# DEMO_TRUCK_ID=00000000-0000-4000-8000-000000000001
# TELEMETRY_RATE_LIMIT=60

# Producción: URL pública de fleet (Vercel)
# FLEET_TRACKING_URL=https://tu-fleet.vercel.app

# Vault (mismo valor que ORDER_WORKER_SECRET). En SQL Editor de Supabase:
# SELECT vault.create_secret('TU_ORDER_WORKER_SECRET', 'ORDER_WORKER_SECRET', 'API key del order-worker');
# SELECT vault.create_secret('https://<project-ref>.supabase.co/functions/v1/order-worker', 'ORDER_WORKER_URL', 'URL del order-worker');
